process {
    // memory and wall time grow with each retry, DIAMOND in --ultra-sensitive mode
    // can need more than the 2 GB that were requested here before
    withLabel: prokka   { cpus = 8 ; memory = { 2.GB * task.attempt } ; time = { 2.h  * task.attempt } }
    withLabel: blast    { cpus = 8 ; memory = { 4.GB * task.attempt } ; time = { 8.h  * task.attempt } }
    withLabel: diamond  { cpus = 8 ; memory = { 4.GB * task.attempt } ; time = { 4.h  * task.attempt } }
    withLabel: pocp     { cpus = 1 ; memory = { 1.GB * task.attempt } ; time = '30 min' }
    withLabel: ruby     { cpus = 1 ; memory = { 1.GB * task.attempt } ; time = '30 min' }
    withLabel: python   { cpus = 1 ; memory = { 2.GB * task.attempt } ; time = '1 h' }
}
