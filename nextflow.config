manifest {
    name = 'hoelzer/pocp'
    author = 'Martin Hölzer'
    homePage = 'https://github.com/hoelzer/pocp'
    description = 'Calculate the percentage of conserved proteins (POCP) between prokaryotic genomes'
    doi = '10.1093/bioinformatics/btae175'
    license = 'GPL-3.0'
    mainScript = 'main.nf'
    defaultBranch = 'main'
    version = '2.4.0'
    // '!' turns the version check into an error instead of a warning
    nextflowVersion = '!>=24.04.0'
}

process {
    // fail a task when any command in a pipe fails, not only the last one
    shell = ['/bin/bash', '-euo', 'pipefail']

    // only retry tasks that were killed by the executor, e.g. because they ran out
    // of memory or wall time, and give them more of both on each attempt. Every
    // other failure still terminates the run right away, as before.
    errorStrategy = { task.exitStatus in ((130..145) + 104) ? 'retry' : 'terminate' }
    maxRetries = 2
}

// default parameters
params {
    max_cores = Runtime.runtime.availableProcessors()
    cores = Runtime.runtime.availableProcessors().intdiv(4)
    memory = '4 GB'
    help = false
    profile = false

    // folder structure
    output = 'results'

    // input 
    genomes = ''
    proteins = ''
    list = false
    // for one-vs-all switch
    genome = false
    protein = false

    // Prokka
    gcode = 0

    // DIAMOND or BLASTP protein alignment
    blastp = false
    evalue = '1e-5'
    seqidentity = 0.4
    alnlength = 0.5

    // publish the raw pairwise alignment tables (one per comparison, N*(N-1) files)
    keep_alignments = false

    // Plot POCP heatmap
    width = 16
    height = 8

    // location for storing the conda environments
    condaCacheDir = 'conda'
    singularityCacheDir = 'singularity'
}


profiles {
    
    ////////////////////////////////////////////////////
    // executors

    local {
        executor {
            name = "local"
            cpus = params.max_cores
            memory = params.memory
        }
        includeConfig 'configs/local.config'
    }

    slurm {
        executor {
            name = "slurm"
            queueSize = 100
            // exitReadTimeout = "360 sec"
            // submitRateLimit = '1 / 2 s'
            // pollInterval = '30 sec'
        }
        process.cache = "lenient"
        includeConfig 'configs/nodes.config'
    }


    ////////////////////////////////////////////////////
    // engines 

    conda {
        conda{
            enabled = true
            cacheDir = params.condaCacheDir
            timeout = '45 min'
        }
        includeConfig 'configs/conda.config'
    }
    mamba {
        conda{
            enabled = true
            cacheDir = params.condaCacheDir
            timeout = '45 min'
            useMamba = true
        }
        includeConfig 'configs/conda.config'
    }
    docker {
        docker {
            enabled = true
            // --platform: all used containers are built for linux/amd64, be explicit about
            // it so that they also run on arm64 hosts such as Apple silicon
            // -u: write result files as the current user instead of as root
            runOptions = '--platform=linux/amd64 -u $(id -u):$(id -g)'
        }
        includeConfig 'configs/container.config'
    }

    singularity {
        singularity {
                enabled = true
                autoMounts = true
                cacheDir = params.singularityCacheDir
        }
        includeConfig 'configs/container.config'
    }

    apptainer {
        apptainer {
                enabled = true
                autoMounts = true
                cacheDir = params.singularityCacheDir
        }
        includeConfig 'configs/container.config'
    }

    ////////////////////////////////////////////////////
    // pre-configured
    // small all-vs-all run on the bundled example data. Only sets the input, so it
    // still needs an executor and an engine, e.g. -profile test,local,docker
    test {
        params {
            proteins = "${projectDir}/example/*.faa"
        }
    }

    // local execution with conda
    standard {
        executor {
            name = "local"
            cpus = params.max_cores
            memory = params.memory
        }
        conda { 
            cacheDir = params.condaCacheDir 
            enabled = true
        }
        includeConfig 'configs/local.config'
        includeConfig 'configs/conda.config' 
    }

}
